WARN = []
def warn(m): WARN.append(m)
def mm(v): return v/10.0
def vi(v): return adsk.core.ValueInput.createByReal(mm(v))
def pt(x, y, z=0.0): return adsk.core.Point3D.create(mm(x), mm(y), mm(z))
NEW = adsk.fusion.FeatureOperations.NewBodyFeatureOperation
JOIN = adsk.fusion.FeatureOperations.JoinFeatureOperation
CUT = adsk.fusion.FeatureOperations.CutFeatureOperation
_planes = {}

# ======================= geometry helpers =======================
def plane_z(comp, z):
    if abs(z) < 1e-9: return comp.xYConstructionPlane
    key = (comp.name, round(z, 3))
    if key not in _planes:
        pin = comp.constructionPlanes.createInput()
        pin.setByOffset(comp.xYConstructionPlane, vi(z))
        pl = comp.constructionPlanes.add(pin); pl.name = 'PLANE_Z_%.2f' % z
        _planes[key] = pl
    return _planes[key]

def sk_new(comp, z, name):
    sk = comp.sketches.add(plane_z(comp, z)); sk.name = name; return sk

def rrect(sk, cx, cy, w, h, r):
    r = max(0.0, min(r, w/2.0-0.01, h/2.0-0.01))
    x0, x1, y0, y1 = cx-w/2.0, cx+w/2.0, cy-h/2.0, cy+h/2.0
    if r < 0.05:
        sk.sketchCurves.sketchLines.addTwoPointRectangle(pt(x0, y0), pt(x1, y1)); return
    L = sk.sketchCurves.sketchLines; A = sk.sketchCurves.sketchArcs; c = math.sqrt(0.5)*r
    l1 = L.addByTwoPoints(pt(x0+r, y0), pt(x1-r, y0))
    a1 = A.addByThreePoints(l1.endSketchPoint, pt(x1-r+c, y0+r-c), pt(x1, y0+r))
    l2 = L.addByTwoPoints(a1.endSketchPoint, pt(x1, y1-r))
    a2 = A.addByThreePoints(l2.endSketchPoint, pt(x1-r+c, y1-r+c), pt(x1-r, y1))
    l3 = L.addByTwoPoints(a2.endSketchPoint, pt(x0+r, y1))
    a3 = A.addByThreePoints(l3.endSketchPoint, pt(x0+r-c, y1-r+c), pt(x0, y1-r))
    l4 = L.addByTwoPoints(a3.endSketchPoint, pt(x0, y0+r))
    A.addByThreePoints(l4.endSketchPoint, pt(x0+r-c, y0+r-c), l1.startSketchPoint)

def circ(sk, x, y, d): sk.sketchCurves.sketchCircles.addByCenterRadius(pt(x, y), mm(d/2.0))
def rect(sk, x0, y0, x1, y1): sk.sketchCurves.sketchLines.addTwoPointRectangle(pt(x0, y0), pt(x1, y1))

def allprofs(sk, profiles=None):
    col = adsk.core.ObjectCollection.create()
    for p in (profiles if profiles is not None else [sk.profiles.item(i) for i in range(sk.profiles.count)]): col.add(p)
    return col

def ext(comp, sk, dist, op, name, profiles=None):
    inp = comp.features.extrudeFeatures.createInput(allprofs(sk, profiles), op)
    inp.setDistanceExtent(False, vi(dist))
    f = comp.features.extrudeFeatures.add(inp); f.name = name; return f

def ext_sym(comp, sk, total, op, name, profiles=None):
    inp = comp.features.extrudeFeatures.createInput(allprofs(sk, profiles), op)
    inp.setSymmetricExtent(vi(total), True)
    f = comp.features.extrudeFeatures.add(inp); f.name = name; return f

def new_comp(parent, name):
    occ = parent.occurrences.addNewComponent(adsk.core.Matrix3D.create()); occ.component.name = name; return occ, occ.component

def fillet_face(comp, body, top, r, label):
    try:
        best = None; bz = None
        for f in body.faces:
            if f.geometry.surfaceType != adsk.core.SurfaceTypes.PlaneSurfaceType: continue
            ok, n = f.evaluator.getNormalAtPoint(f.pointOnFace)
            if abs(n.z) < 0.99 or (n.z > 0) != top: continue
            z = f.pointOnFace.z
            if bz is None or (top and z > bz) or ((not top) and z < bz): best, bz = f, z
        edges = adsk.core.ObjectCollection.create()
        for lp in best.loops:
            if lp.isOuter:
                for e in lp.edges: edges.add(e)
        fi = comp.features.filletFeatures.createInput(); fi.addConstantRadiusEdgeSet(edges, vi(r), True)
        comp.features.filletFeatures.add(fi).name = label
    except: warn('Fillet skipped (%s)' % label)

def vsketch(comp, axis, coord, name):
    """sketch on a vertical plane through x=coord (axis 'X') or y=coord (axis 'Y'); sign verified at run time"""
    base = comp.yZConstructionPlane if axis == 'X' else comp.xZConstructionPlane
    for sign in (1, -1):
        pin = comp.constructionPlanes.createInput(); pin.setByOffset(base, vi(sign*coord))
        pl = comp.constructionPlanes.add(pin); sk = comp.sketches.add(pl)
        try:
            o = sk.sketchToModelSpace(adsk.core.Point3D.create(0, 0, 0)); v = o.x if axis == 'X' else o.y
            good = abs(v - mm(coord)) < 1e-6
        except: good = True
        if good: sk.name = name; return sk
        sk.deleteMe(); pl.deleteMe()
    raise RuntimeError('vertical plane failed ' + name)

def msp(sk, x, y, z):
    p = sk.modelToSketchSpace(pt(x, y, z)); return adsk.core.Point3D.create(p.x, p.y, 0)

def wall_cut(comp, axis, coord, shapes, name, total):
    """shapes: ('rect',a0,b0,a1,b1) / ('circ',a,b,d). (a,b)=(Y,Z) for axis X, (X,Z) for axis Y"""
    sk = vsketch(comp, axis, coord, 'SK_' + name)
    def M(a, b): return msp(sk, coord, a, b) if axis == 'X' else msp(sk, a, coord, b)
    for s in shapes:
        if s[0] == 'rect': sk.sketchCurves.sketchLines.addTwoPointRectangle(M(s[1], s[2]), M(s[3], s[4]))
        else: sk.sketchCurves.sketchCircles.addByCenterRadius(M(s[1], s[2]), mm(s[3]/2.0))
    ext_sym(comp, sk, total, CUT, 'CUT_' + name)

def text_profiles(sk):
    ps = [sk.profiles.item(i) for i in range(sk.profiles.count)]; out = []
    for p in ps:
        inner = False
        if p.profileLoops.count == 1:
            b = p.boundingBox
            for q in ps:
                if q is p or q.profileLoops.count < 2: continue
                c = q.boundingBox
                if c.minPoint.x <= b.minPoint.x and c.minPoint.y <= b.minPoint.y and c.maxPoint.x >= b.maxPoint.x and c.maxPoint.y >= b.maxPoint.y: inner = True
        if not inner: out.append(p)
    return out

def add_text(sk, txt, h, cx, cy, w):
    ti = sk.sketchTexts.createInput2(txt, mm(h))
    ti.setAsMultiLine(pt(cx-w/2.0, cy-h), pt(cx+w/2.0, cy+h), adsk.core.HorizontalAlignments.CenterHorizontalAlignment, adsk.core.VerticalAlignments.MiddleVerticalAlignment, 0)
    sk.sketchTexts.add(ti)

def box_body(comp, x0, y0, z0, x1, y1, z1, name):
    sk = sk_new(comp, z0, 'SK_' + name); rect(sk, x0, y0, x1, y1)
    f = ext(comp, sk, z1-z0, NEW, 'EXT_' + name); f.bodies.item(0).name = name; return f.bodies.item(0)

def ring_rects(x0, x1, y0, y1, c, t, seg, sides):
    """corner-guide strips around a footprint; sides subset of 'LRBT'; seg = segment length from each end"""
    R = []
    if 'L' in sides: R += [(x0-c-t, y0, x0-c, y0+seg), (x0-c-t, y1-seg, x0-c, y1)]
    if 'R' in sides: R += [(x1+c, y0, x1+c+t, y0+seg), (x1+c, y1-seg, x1+c+t, y1)]
    if 'B' in sides: R += [(x0, y0-c-t, x0+seg, y0-c), (x1-seg, y0-c-t, x1, y0-c)]
    if 'T' in sides: R += [(x0, y1+c, x0+seg, y1+c+t), (x1-seg, y1+c, x1, y1+c+t)]
    return R

# ======================= layout (single source of truth) =======================
def layout(P):
    hx = P['enclosureWidth']/2.0-P['wallThickness']; hy = P['enclosureLength']/2.0-P['wallThickness']
    base = P['baseThickness']; Zi = P['enclosureHeight']-P['frontPlateThickness']; C = {}
    def bx(n, cx, cy, w, l, z0, h): C[n] = dict(x0=cx-w/2.0, x1=cx+w/2.0, y0=cy-l/2.0, y1=cy+l/2.0, z0=z0, z1=z0+h)
    bx('TP4056', P['tpCenterX'], -hy+0.6+P['tpLength']/2.0, P['tpWidth'], P['tpLength'], base+P['tpStandoff'], P['tpHeight'])
    hy0 = C['TP4056']['y1']+3.0
    C['BATTERY_HOLDER'] = dict(x0=-hx+0.6, x1=-hx+0.6+P['holderWidth'], y0=hy0, y1=hy0+P['holderLength'], z0=base, z1=base+P['holderHeight'])
    bx('NRF24', P['nrfCenterX'], hy-0.6-P['nrfLength']/2.0, P['nrfWidth'], P['nrfLength'], base+P['nrfStandoff'], P['nrfHeight'])
    sx = P['switchCenterX']; sw = P['switchBodyWidth']; sz = P['switchCenterZ']; sh = P['switchBodyHeight']
    C['SWITCH'] = dict(x0=sx-sw/2.0, x1=sx+sw/2.0, y0=hy-P['switchDepth'], y1=hy, z0=sz-sh/2.0, z1=sz+sh/2.0)
    C['AMS1117'] = dict(x0=hx-27.1, x1=hx-27.1+P['amsLength'], y0=2.0, y1=2.0+P['amsWidth'], z0=base+P['amsStandoff'], z1=base+P['amsStandoff']+P['amsHeight'])
    bx('ESP32', P['esp32CenterX'], -hy+0.5+P['esp32Length']/2.0, P['esp32Width'], P['esp32Length'], base+P['esp32Standoff'], P['esp32Height'])
    bz = base+1.0; bd = P['buzzerDiameter']
    C['BUZZER'] = dict(x0=hx-0.5-P['buzzerHeight'], x1=hx-0.5, y0=P['buzzerY']-bd/2.0, y1=P['buzzerY']+bd/2.0, z0=bz, z1=bz+bd)
    oy = P['oledCenterY']-P['oledActiveOffsetY']; opz = Zi-P['oledPostHeight']
    bx('OLED_PCB', 0, oy, P['oledPcbWidth'], P['oledPcbHeight'], opz-1.6, 1.6)
    bx('OLED_GLASS', 0, P['oledCenterY'], P['oledGlassWidth'], P['oledGlassHeight'], opz, P['oledGlassThickness'])
    top = Zi-P['keyFlangeThickness']-P['tactHeight']-P['keyPlay']; r2 = P['keyRow1Y']-P['keyPitchY']
    bx('KEYPAD_BOARD', 0, (P['keyRow1Y']+r2)/2.0, P['keypadBoardWidth'], P['keypadBoardHeight'], top-P['keypadBoardThickness']-P['keypadTailDepth'], P['keypadBoardThickness']+P['keypadTailDepth']+P['tactHeight'])
    G = dict(hx=hx, hy=hy, base=base, Zi=Zi, boardTop=top, joinZ=P['splitHeight']+P['lipHeight']+P['shellGap'], oledPcbY=oy, row2Y=r2)
    return C, G

def gap3(a, b):
    return max(a['x0']-b['x1'], b['x0']-a['x1'], a['y0']-b['y1'], b['y0']-a['y1'], a['z0']-b['z1'], b['z0']-a['z1'])

def run_checks(P, C, G):
    out = []; ok = True
    def chk(label, val, need, op='>='):
        nonlocal ok
        passed = (val >= need) if op == '>=' else (val <= need)
        if not passed: ok = False
        out.append('%-4s %-52s %8.2f  (need %s %.2f)' % ('PASS' if passed else 'FAIL', label, val, op, need))
    names = list(C.keys())
    for i in range(len(names)):
        for j in range(i+1, len(names)):
            a, b = names[i], names[j]
            if {a, b} == {'OLED_PCB', 'OLED_GLASS'}: continue
            need = 25.0 if {a, b} == {'NRF24', 'BATTERY_HOLDER'} else (P['pcbClearance'] if {a, b} == {'SWITCH', 'BATTERY_HOLDER'} else 2.0)
            chk('clearance %s <-> %s (mm)' % (a, b), gap3(C[a], C[b]), need) if gap3(C[a], C[b]) < 10 or need > 2.0 else None
    for n in ('TP4056', 'BATTERY_HOLDER', 'NRF24', 'AMS1117', 'ESP32', 'BUZZER'):
        c = C[n]; chk('wall clearance %s (min of 4 sides)' % n, min(c['x0']+G['hx'], G['hx']-c['x1'], c['y0']+G['hy'], G['hy']-c['y1']), 0.4)
    chk('ESP32 USB centre <-> TP4056 USB centre (mm)', abs(P['esp32CenterX']-P['tpCenterX']), 30.0)
    chk('NRF24 top -> OLED underside (Dupont 15 mm)', C['OLED_PCB']['z0']-C['NRF24']['z1'], P['dupontClearance'])
    chk('Battery holder top -> hold-down rib (mm)', 0.3, 0.2)
    chk('Battery top lead buffer to corner boss (mm)', G['hy']-P['screwBossDiameter']-C['BATTERY_HOLDER']['y1'], P['wireClearance'])
    chk('Rear cavity height above floor vs holder (mm)', P['splitHeight']-C['BATTERY_HOLDER']['z1'], 2.0)
    chk('ESP32 USB cutout top below split line (mm)', P['splitHeight']-(C['ESP32']['z0']+1.6+P['esp32UsbCenterAbovePcb']+P['usbCutoutHeight']/2.0), 1.0)
    chk('TP4056 USB cutout bottom above floor (mm)', C['TP4056']['z0']+P['tpUsbCenterAbovePcb']-P['usbCutoutHeight']/2.0-G['base'], 1.0)
    chk('Wall thickness (mm, FDM >= 1.6)', P['wallThickness'], 1.6)
    chk('Key hole to key-hole web (mm)', P['keyPitchY']-P['buttonHoleDiameter'], 3.0)
    chk('Keypad right edge to inner wall (mm)', G['hx']-(P['keyPitchX']+P['keycapDiameter']/2.0+1.0), 1.5)
    vol_in = (2*G['hx'])*(2*G['hy'])*(P['enclosureHeight']-P['baseThickness']-P['frontPlateThickness'])
    vol_c = sum((c['x1']-c['x0'])*(c['y1']-c['y0'])*(c['z1']-c['z0']) for n, c in C.items() if n != 'OLED_GLASS')
    out.append('INFO internal volume %.0f cm3, component envelope volume %.0f cm3 (fill %.0f%%)' % (vol_in/1000.0, vol_c/1000.0, 100*vol_c/vol_in))
    return ok, out

# ======================= builders =======================
def corner_centers(P, G):
    r = P['screwBossDiameter']/2.0
    return [(sx*(G['hx']-r), sy*(G['hy']-r)) for sx in (-1, 1) for sy in (-1, 1)]

def floor_groups(P, C, G):
    gr = {}; t = 1.2; c = P['pcbClearance']
    def add(h, rs): gr.setdefault(round(h, 2), []).extend(rs)
    E = C['ESP32']; sp = P['esp32Standoff']
    rails = [(E['x0'], E['y0']+0.8, E['x1'], E['y0']+5.8), (E['x0'], E['y1']-5.8, E['x1'], E['y1']-0.8)]
    add(sp, rails)
    add(sp+1.6, [(E['x0']-c-t, r[1], E['x0']-c, r[3]) for r in rails]+[(E['x1']+c, r[1], E['x1']+c+t, r[3]) for r in rails]+[(E['x0']-c-t, E['y1']+c, E['x1']+c+t, E['y1']+c+t)])
    T = C['TP4056']; ts = P['tpStandoff']
    add(ts, [(T['x0']+1, T['y0']+1, T['x0']+6, T['y0']+6), (T['x1']-6, T['y0']+1, T['x1']-1, T['y0']+6), (T['x0']+1, T['y1']-6, T['x0']+6, T['y1']-1), (T['x1']-6, T['y1']-6, T['x1']-1, T['y1']-1)])
    add(ts+1.0, ring_rects(T['x0'], T['x1'], T['y0'], T['y1'], c, t, 8, 'LRT'))
    N = C['NRF24']; ns = P['nrfStandoff']
    add(ns, [(N['x0']+1, N['y1']-8, N['x1']-1, N['y1']-3), (N['x0']+1, N['y0']+17, N['x1']-1, N['y0']+22)])
    add(ns+1.6, ring_rects(N['x0'], N['x1'], N['y0'], N['y1'], c, t, 5, 'LRB'))
    A = C['AMS1117']; ams = P['amsStandoff']
    add(ams, [(A['x0']+1, A['y0'], A['x0']+4, A['y1']), (A['x1']-4, A['y0'], A['x1']-1, A['y1'])])
    add(ams+1.0, [(A['x0'], A['y0']-c-t, A['x1'], A['y0']-c), (A['x0'], A['y1']+c, A['x1'], A['y1']+c+t)])
    H = C['BATTERY_HOLDER']; hh = 10.0
    add(hh, [(H['x1']+0.4, H['y0']-0.4-t, H['x1']+0.4+t, H['y1']+0.4+t)])
    add(hh, [(H['x0'], H['y0']-0.4-t, H['x0']+6, H['y0']-0.4), (H['x1']-6, H['y0']-0.4-t, H['x1'], H['y0']-0.4), (H['x0'], H['y1']+0.4, H['x0']+6, H['y1']+0.4+t), (H['x1']-6, H['y1']+0.4, H['x1'], H['y1']+0.4+t)])
    add(8.0, [(H['x1']+0.4+t+5.5, H['y0']+4, H['x1']+0.4+t+5.5+t, H['y1']-9)])
    Z = C['BUZZER']; cy = P['buzzerY']; bd = P['buzzerDiameter']
    add(0.8, [(Z['x0'], cy-3, Z['x1'], cy+3)])
    add(7.0, [(Z['x0'], cy-bd/2-0.3-t, Z['x1'], cy-bd/2-0.3), (Z['x0'], cy+bd/2+0.3, Z['x1'], cy+bd/2+0.3+t)])
    return gr

def build_rear(master, P, C, G):
    occ, comp = new_comp(master, 'REAR_SHELL')
    W, Ln, r, wall, base, sp = P['enclosureWidth'], P['enclosureLength'], P['cornerRadius'], P['wallThickness'], P['baseThickness'], P['splitHeight']
    lip, gap = P['lipHeight'], P['shellGap']
    sk = sk_new(comp, 0, 'SK_REAR_OUTER'); rrect(sk, 0, 0, W, Ln, r)
    body = ext(comp, sk, sp, NEW, 'EXT_REAR_OUTER').bodies.item(0); body.name = 'REAR_SHELL'
    fillet_face(comp, body, False, P['edgeFillet'], 'FILLET_REAR_BOTTOM')
    ins = wall/2.0+gap
    sk = sk_new(comp, sp-0.3, 'SK_REAR_TONGUE'); rrect(sk, 0, 0, W-2*ins, Ln-2*ins, r-ins)
    ext(comp, sk, lip+0.3, JOIN, 'EXT_REAR_TONGUE')
    sk = sk_new(comp, base, 'SK_REAR_CAVITY'); rrect(sk, 0, 0, W-2*wall, Ln-2*wall, r-wall)
    ext(comp, sk, sp+lip-base+0.5, CUT, 'CUT_REAR_CAVITY')
    cc = corner_centers(P, G)
    sk = sk_new(comp, base-0.3, 'SK_REAR_SCREW_BOSSES')
    for x, y in cc: circ(sk, x, y, P['screwBossDiameter'])
    ext(comp, sk, G['joinZ']-(base-0.3), JOIN, 'EXT_REAR_SCREW_BOSSES')
    for h, rs in sorted(floor_groups(P, C, G).items()):
        sk = sk_new(comp, base-0.3, 'SK_REAR_STANDOFFS_RIBS_H%.1f' % h)
        for q in rs: rect(sk, *q)
        ext(comp, sk, h+0.3, JOIN, 'EXT_REAR_STANDOFFS_RIBS_H%.1f' % h)
    sk = sk_new(comp, 0, 'SK_REAR_SCREW_THROUGH')
    for x, y in cc: circ(sk, x, y, P['m3Clearance'])
    ext(comp, sk, G['joinZ']+0.5, CUT, 'CUT_REAR_SCREW_THROUGH')
    sk = sk_new(comp, 0, 'SK_REAR_SCREW_CBORE')
    for x, y in cc: circ(sk, x, y, P['m3HeadDiameter'])
    ext(comp, sk, P['m3HeadDepth'], CUT, 'CUT_REAR_SCREW_CBORE')
    tot = wall+2.0; hy2 = Ln/2.0-wall/2.0; hx2 = W/2.0-wall/2.0
    uh, uw = P['usbCutoutHeight'], P['usbCutoutWidth']
    ez = C['ESP32']['z0']+1.6+P['esp32UsbCenterAbovePcb']; tz = C['TP4056']['z0']+P['tpUsbCenterAbovePcb']
    wall_cut(comp, 'Y', -hy2, [('rect', P['esp32CenterX']-uw/2, ez-uh/2, P['esp32CenterX']+uw/2, ez+uh/2), ('rect', P['tpCenterX']-uw/2, tz-uh/2, P['tpCenterX']+uw/2, tz+uh/2)], 'USB_CUTOUTS', tot)
    sw, sh = P['switchCutoutWidth'], P['switchCutoutHeight']; sx, sz = P['switchCenterX'], P['switchCenterZ']
    wall_cut(comp, 'Y', hy2, [('rect', sx-sw/2, sz-sh/2, sx+sw/2, sz+sh/2)], 'SWITCH_CUTOUT', tot)
    nx = P['nrfCenterX']; nz = C['NRF24']['z0']+1.6+P['smaAxisAbovePcb']; ex = P['smaSlotExtra']; sd = P['smaHoleDiameter']
    wall_cut(comp, 'Y', hy2, [('circ', nx, nz+ex/2, sd), ('circ', nx, nz-ex/2, sd), ('rect', nx-sd/2, nz-ex/2, nx+sd/2, nz+ex/2)], 'SMA_OPENING', tot)
    bz = (C['BUZZER']['z0']+C['BUZZER']['z1'])/2.0; gd = P['grilleHoleDiameter']; by = P['buzzerY']; pitch = gd+1.4
    holes = [('circ', by, bz, gd)]+[('circ', by+pitch*math.cos(math.radians(a)), bz+pitch*math.sin(math.radians(a)), gd) for a in range(0, 360, 60)]
    wall_cut(comp, 'X', hx2, holes, 'BUZZER_GRILLE', tot)
    return occ, comp, body

def build_front(master, P, C, G):
    occ, comp = new_comp(master, 'FRONT_SHELL')
    W, Ln, r, wall, sp, H = P['enclosureWidth'], P['enclosureLength'], P['cornerRadius'], P['wallThickness'], P['splitHeight'], P['enclosureHeight']
    lip, gap, Zi, plate = P['lipHeight'], P['shellGap'], G['Zi'], P['frontPlateThickness']
    sk = sk_new(comp, sp, 'SK_FRONT_OUTER'); rrect(sk, 0, 0, W, Ln, r)
    body = ext(comp, sk, H-sp, NEW, 'EXT_FRONT_OUTER').bodies.item(0); body.name = 'FRONT_SHELL'
    fillet_face(comp, body, True, P['edgeFillet'], 'FILLET_FRONT_TOP')
    sk = sk_new(comp, sp-0.2, 'SK_FRONT_CAVITY'); rrect(sk, 0, 0, W-2*wall, Ln-2*wall, r-wall)
    ext(comp, sk, Zi-(sp-0.2), CUT, 'CUT_FRONT_CAVITY')
    sk = sk_new(comp, sp-0.2, 'SK_FRONT_GROOVE'); rrect(sk, 0, 0, W-wall, Ln-wall, r-wall/2.0)
    ext(comp, sk, lip+gap+0.2, CUT, 'CUT_FRONT_GROOVE')
    cc = corner_centers(P, G)
    sk = sk_new(comp, G['joinZ'], 'SK_FRONT_SCREW_BOSSES')
    for x, y in cc: circ(sk, x, y, P['screwBossDiameter'])
    ext(comp, sk, Zi+0.3-G['joinZ'], JOIN, 'EXT_FRONT_SCREW_BOSSES')
    sk = sk_new(comp, G['joinZ'], 'SK_FRONT_SCREW_PILOTS')
    for x, y in cc: circ(sk, x, y, P['m3Pilot'])
    ext(comp, sk, Zi-1.6-G['joinZ'], CUT, 'CUT_FRONT_SCREW_PILOTS')
    # posts grouped by their bottom Z
    posts = {}; pilots = {}
    opz = Zi-P['oledPostHeight']; ox, oy = 0.0, G['oledPcbY']
    for sx in (-1, 1):
        for sy in (-1, 1):
            posts.setdefault(round(opz, 2), []).append(('c', sx*P['oledHoleDX']/2, oy+sy*P['oledHoleDY']/2, P['postDiameter']))
    kx = P['keyPitchX']/2.0; r1 = P['keyRow1Y']; r2 = G['row2Y']
    for sx in (-1, 1):
        for y in (r1+5.0, (r1+r2)/2.0, r2-5.0): posts.setdefault(round(G['boardTop'], 2), []).append(('c', sx*kx, y, P['postDiameter']))
    Hh = C['BATTERY_HOLDER']; hx0 = (Hh['x0']+Hh['x1'])/2.0
    for yy in (17.0, 41.0): posts.setdefault(round(Hh['z1']+0.3, 2), []).append(('r', hx0-7, yy-1.5, hx0+7, yy+1.5))
    for z, items in sorted(posts.items()):
        sk = sk_new(comp, z, 'SK_FRONT_POSTS_Z%.1f' % z)
        for it in items:
            if it[0] == 'c': circ(sk, it[1], it[2], it[3])
            else: rect(sk, *it[1:])
        ext(comp, sk, Zi+0.3-z, JOIN, 'EXT_FRONT_POSTS_Z%.1f' % z)
        cs = [it for it in items if it[0] == 'c']
        if cs:
            sk = sk_new(comp, z, 'SK_FRONT_POST_PILOTS_Z%.1f' % z)
            for it in cs: circ(sk, it[1], it[2], P['m2Pilot'])
            ext(comp, sk, min(8.0, Zi-z+1.0), CUT, 'CUT_FRONT_POST_PILOTS_Z%.1f' % z)
    # OLED window + key holes
    sk = sk_new(comp, Zi-0.2, 'SK_OLED_WINDOW'); rect(sk, -P['oledWindowWidth']/2, P['oledCenterY']-P['oledWindowHeight']/2, P['oledWindowWidth']/2, P['oledCenterY']+P['oledWindowHeight']/2)
    ext(comp, sk, plate+0.7, CUT, 'CUT_OLED_WINDOW')
    sk = sk_new(comp, Zi-0.2, 'SK_KEY_HOLES')
    for x, y in keycentres(P, G): circ(sk, x, y, P['buttonHoleDiameter'])
    ext(comp, sk, plate+0.7, CUT, 'CUT_KEY_HOLES')
    try:
        sk = sk_new(comp, H-0.4, 'SK_FRONT_LABEL'); add_text(sk, 'NRF24 LINK', 5.0, 0, 50.0, 40.0)
        ext(comp, sk, 0.6, CUT, 'CUT_FRONT_LABEL', text_profiles(sk))
    except: warn('Front label engraving skipped')
    return occ, comp, body

def keycentres(P, G):
    return [(c*P['keyPitchX'], y) for y in (P['keyRow1Y'], G['row2Y']) for c in (-1, 0, 1)]

LABELS = [('1', 'ABCDEF'), ('2', 'GHIJKLM'), ('3', 'NOPQRST'), ('4', 'UVWXYZ'), ('5', 'SPACE'), ('6', 'DEL/SEND')]

def build_keycaps(master, P, G):
    occ, comp = new_comp(master, 'KEYCAPS')
    fz = G['Zi']-P['keyFlangeThickness']; top = P['enclosureHeight']+P['keycapProtrusion']; kc = keycentres(P, G)
    sk = sk_new(comp, fz, 'SK_KEYCAP_FLANGES')
    for x, y in kc: circ(sk, x, y, P['buttonHoleDiameter']+2.0)
    ext(comp, sk, P['keyFlangeThickness'], NEW, 'EXT_KEYCAP_FLANGES')
    sk = sk_new(comp, fz+0.3, 'SK_KEYCAP_CAPS')
    for x, y in kc: circ(sk, x, y, P['keycapDiameter'])
    ext(comp, sk, top-(fz+0.3), JOIN, 'EXT_KEYCAP_CAPS')
    bodies = sorted([comp.bRepBodies.item(i) for i in range(comp.bRepBodies.count)], key=lambda b: (-round(b.boundingBox.minPoint.y, 1), b.boundingBox.minPoint.x))
    for i, b in enumerate(bodies): b.name = 'KEYCAP_%d' % (i+1)
    try:
        edges = adsk.core.ObjectCollection.create()
        for b in bodies:
            best = None
            for f in b.faces:
                if f.geometry.surfaceType == adsk.core.SurfaceTypes.PlaneSurfaceType and (best is None or f.pointOnFace.z > best.pointOnFace.z): best = f
            for e in best.edges: edges.add(e)
        fi = comp.features.filletFeatures.createInput(); fi.addConstantRadiusEdgeSet(edges, vi(1.0), True); comp.features.filletFeatures.add(fi).name = 'FILLET_KEYCAP_TOPS'
    except: warn('Keycap fillet skipped')
    try:
        sk = sk_new(comp, top, 'SK_KEYCAP_LABELS')
        for (x, y), (n, t) in zip(kc, LABELS):
            add_text(sk, n, 3.0, x, y+2.6, 12.0); add_text(sk, t, 1.9, x, y-2.8, 13.0)
        ext(comp, sk, 0.4, JOIN, 'EXT_KEYCAP_LABELS', text_profiles(sk))
    except: warn('Keycap label text skipped')
    return occ, comp

def build_refs(master, P, C, G):
    occ, comp = new_comp(master, 'REFERENCE_ENVELOPES_HIDDEN_FOR_CHECKS'); bodies = []
    for n in ('ESP32', 'TP4056', 'AMS1117', 'BATTERY_HOLDER', 'SWITCH', 'OLED_PCB', 'OLED_GLASS', 'KEYPAD_BOARD', 'NRF24'):
        c = C[n]; bodies.append(box_body(comp, c['x0'], c['y0'], c['z0'], c['x1'], c['y1'], c['z1'], 'REF_' + n))
    try:
        Z = C['BUZZER']; cy = P['buzzerY']; cz = (Z['z0']+Z['z1'])/2.0; sk = vsketch(comp, 'X', (Z['x0']+Z['x1'])/2.0, 'SK_REF_BUZZER')
        sk.sketchCurves.sketchCircles.addByCenterRadius(msp(sk, (Z['x0']+Z['x1'])/2.0, cy, cz), mm(P['buzzerDiameter']/2.0))
        f = ext_sym(comp, sk, P['buzzerHeight'], NEW, 'EXT_REF_BUZZER'); f.bodies.item(0).name = 'REF_BUZZER'; bodies.append(f.bodies.item(0))
        N = C['NRF24']; ny = N['y1']+P['nrfConnectorExt']/2.0; nz = N['z0']+1.6+P['smaAxisAbovePcb']; sk = vsketch(comp, 'Y', ny, 'SK_REF_SMA')
        sk.sketchCurves.sketchCircles.addByCenterRadius(msp(sk, P['nrfCenterX'], ny, nz), mm(P['nrfConnectorDia']/2.0))
        f = ext_sym(comp, sk, P['nrfConnectorExt'], NEW, 'EXT_REF_SMA'); f.bodies.item(0).name = 'REF_NRF24_SMA_CONNECTOR'; bodies.append(f.bodies.item(0))
    except: warn('Cylindrical reference bodies skipped')
    return occ, comp, bodies

