    # ---- buzzer ----
    c = sub('BUZZER_12MM'); Z = C['BUZZER']
    vcyl(c, 'X', (Z['x0']+Z['x1'])/2.0, P['buzzerY'], (Z['z0']+Z['z1'])/2.0, P['buzzerDiameter'], P['buzzerHeight'], 'BUZZER_BODY', 'black')
    # ---- 18650 holder + cell ----
    c = sub('BATTERY_HOLDER_18650_WITH_CELL'); H = C['BATTERY_HOLDER']; hx0 = (H['x0']+H['x1'])/2.0; z0 = H['z0']
    vb(c, H['x0'], H['y0'], z0, H['x1'], H['y1'], z0+0.8, 'HOLDER_BASE', 'black')
    vb(c, H['x0'], H['y0']+4, z0+0.8, H['x0']+1.8, H['y1']-4, z0+12, 'HOLDER_WALL_L', 'black')
    vb(c, H['x1']-1.8, H['y0']+4, z0+0.8, H['x1'], H['y1']-4, z0+12, 'HOLDER_WALL_R', 'black')
    vb(c, H['x0'], H['y0'], z0+0.8, H['x1'], H['y0']+4, z0+16, 'HOLDER_END_NEG', 'black')
    vb(c, H['x0'], H['y1']-4, z0+0.8, H['x1'], H['y1'], z0+16, 'HOLDER_END_POS', 'black')
    vb(c, hx0-4, H['y1']-4.4, z0+6, hx0+4, H['y1']-4, z0+14, 'HOLDER_CONTACT_POS', 'silver')
    vcyl(c, 'Y', H['y0']+4.7, hx0, z0+10.0, 5.0, 1.4, 'HOLDER_SPRING_NEG', 'silver')
    vcyl(c, 'Y', (H['y0']+H['y1'])/2.0, hx0, z0+0.8+P['cellDiameter']/2.0, P['cellDiameter'], 65.2, 'CELL_18650', 'cell')
    vb(c, hx0+1.3, H['y1'], z0+7.3, hx0+2.7, H['y1']+5, z0+8.7, 'WIRE_RED', 'red')
    vb(c, hx0-2.7, H['y0']-2.5, z0+7.3, hx0-1.3, H['y0'], z0+8.7, 'WIRE_BLACK', 'black')
    # ---- KCD1-11 rocker switch ----
    c = sub('KCD1_11_ROCKER_SWITCH'); sx, sz = P['switchCenterX'], P['switchCenterZ']; hy = G['hy']; wl = P['wallThickness']
    vb(c, sx-9.6, hy-14, sz-6.45, sx+9.6, hy+wl, sz+6.45, 'SWITCH_BODY', 'black')
    vb(c, sx-10.75, hy+wl, sz-7.6, sx+10.75, hy+wl+1.0, sz+7.6, 'SWITCH_BEZEL', 'black')
    vb(c, sx-8.5, hy+wl+1.0, sz-5.0, sx+8.5, hy+wl+3.5, sz+5.0, 'SWITCH_ROCKER', 'red')
    for k in (-1, 1): vb(c, sx+k*4-2.375, hy-20, sz-0.4, sx+k*4+2.375, hy-14, sz+0.4, 'SWITCH_TERMINAL_%s' % ('A' if k < 0 else 'B'), 'gold')
    return occ

# ======================= DXF sheets =======================
def wall_panel(sk, ox, oy, w, h, shapes):
    rect(sk, ox, oy, ox+w, oy+h)
    for s in shapes:
        if s[0] == 'rect': rect(sk, ox+s[1], oy+s[2], ox+s[3], oy+s[4])
        else: circ(sk, ox+s[1], oy+s[2], s[3])

def dxf_shapes(P, C, G):
    W, L = P['enclosureWidth'], P['enclosureLength']; uh, uw = P['usbCutoutHeight'], P['usbCutoutWidth']
    ez = C['ESP32']['z0']+1.6+P['esp32UsbCenterAbovePcb']; tz = C['TP4056']['z0']+P['tpUsbCenterAbovePcb']
    u = lambda x: x+W/2.0
    usb = [('rect', u(P['esp32CenterX'])-uw/2, ez-uh/2, u(P['esp32CenterX'])+uw/2, ez+uh/2), ('rect', u(P['tpCenterX'])-uw/2, tz-uh/2, u(P['tpCenterX'])+uw/2, tz+uh/2)]
    sw, sh = P['switchCutoutWidth'], P['switchCutoutHeight']; sx, sz = u(P['switchCenterX']), P['switchCenterZ']
    swc = [('rect', sx-sw/2, sz-sh/2, sx+sw/2, sz+sh/2)]
    nx = u(P['nrfCenterX']); nz = C['NRF24']['z0']+1.6+P['smaAxisAbovePcb']; ex = P['smaSlotExtra']; sd = P['smaHoleDiameter']
    sma = [('circ', nx, nz+ex/2, sd), ('circ', nx, nz-ex/2, sd), ('rect', nx-sd/2, nz-ex/2, nx+sd/2, nz+ex/2)]
    bz = (C['BUZZER']['z0']+C['BUZZER']['z1'])/2.0; gd = P['grilleHoleDiameter']; pitch = gd+1.4; by = P['buzzerY']+L/2.0
    gril = [('circ', by, bz, gd)]+[('circ', by+pitch*math.cos(math.radians(a)), bz+pitch*math.sin(math.radians(a)), gd) for a in range(0, 360, 60)]
    return usb, swc, sma, gril

def front_features(sk, P, G, ox=0.0, oy=0.0):
    rrect(sk, ox, oy, P['enclosureWidth'], P['enclosureLength'], P['cornerRadius'])
    rect(sk, ox-P['oledWindowWidth']/2, oy+P['oledCenterY']-P['oledWindowHeight']/2, ox+P['oledWindowWidth']/2, oy+P['oledCenterY']+P['oledWindowHeight']/2)
    for x, y in keycentres(P, G): circ(sk, ox+x, oy+y, P['buttonHoleDiameter'])

def rear_features(sk, P, G, ox=0.0, oy=0.0):
    rrect(sk, ox, oy, P['enclosureWidth'], P['enclosureLength'], P['cornerRadius'])
    for x, y in corner_centers(P, G): circ(sk, ox+x, oy+y, P['m3Clearance'])

def build_dxf(master, P, C, G, outdir):
    occ, comp = new_comp(master, 'DXF_SKETCHES'); W, L = P['enclosureWidth'], P['enclosureLength']; files = []
    usb, swc, sma, gril = dxf_shapes(P, C, G); sph = P['splitHeight']
    def sheet(name, fn):
        sk = sk_new(comp, 0, name); fn(sk)
        try: sk.saveAsDXF(os.path.join(outdir, name+'.dxf')); files.append(name+'.dxf')
        except: warn('DXF export failed: '+name)
    sheet('01_FRONT_PANEL', lambda sk: front_features(sk, P, G))
    sheet('02_REAR_PANEL', lambda sk: rear_features(sk, P, G))
    def oled(sk):
        rect(sk, -P['oledWindowWidth']/2, -P['oledWindowHeight']/2, P['oledWindowWidth']/2, P['oledWindowHeight']/2)
        rect(sk, -P['oledPcbWidth']/2, -P['oledPcbHeight']/2+P['oledActiveOffsetY'], P['oledPcbWidth']/2, P['oledPcbHeight']/2+P['oledActiveOffsetY'])
        for sx in (-1, 1):
            for sy in (-1, 1): circ(sk, sx*P['oledHoleDX']/2, P['oledActiveOffsetY']+sy*P['oledHoleDY']/2, P['m2Clearance'])
    sheet('03_OLED_PANEL', oled)
    def keys(sk):
        for x, y in keycentres(P, G):
            circ(sk, x, y, P['buttonHoleDiameter']); circ(sk, x, y, P['buttonHoleDiameter']+2.0); rect(sk, x-3, y-3, x+3, y+3)
        r1, r2 = P['keyRow1Y'], G['row2Y']; bh = P['keypadBoardHeight']; cy = (r1+r2)/2.0
        rect(sk, -P['keypadBoardWidth']/2, cy-bh/2, P['keypadBoardWidth']/2, cy+bh/2)
        for sx in (-1, 1):
            for y in (r1+5.0, cy, r2-5.0): circ(sk, sx*P['keyPitchX']/2, y, P['m2Clearance'])
    sheet('04_BUTTON_PATTERN', keys)
    sheet('05_SWITCH_CUTOUT', lambda sk: wall_panel(sk, -W/2, 0, W, sph, swc))
    sheet('06_USB_CUTOUTS', lambda sk: wall_panel(sk, -W/2, 0, W, sph, usb))
    sheet('07_SMA_CUTOUT', lambda sk: wall_panel(sk, -W/2, 0, W, sph, sma))
    def flat(sk):
        front_features(sk, P, G, 0, 0); rear_features(sk, P, G, W+15, 0)
        y0 = -L/2-15-sph; wall_panel(sk, -W/2, y0, W, sph, usb)
        wall_panel(sk, W/2+10, y0, W, sph, swc[:1]+sma)
        wall_panel(sk, -W/2, y0-sph-10, L, sph, gril)
        wall_panel(sk, -W/2+L+10, y0-sph-10, L, sph, [])
    sheet('08_FULL_FLAT_PROFILE', flat)
    return occ, comp, files

# ======================= main =======================
def read_existing(app, P):
    try:
        d = adsk.fusion.Design.cast(app.activeProduct)
        if d and d.userParameters.itemByName('enclosureLength'):
            for k in P:
                prm = d.userParameters.itemByName(k)
                if prm and isinstance(prm.value, (int, float)): P[k] = prm.value*10.0
            return True
    except: pass
    return False

def run(context):
    ui = None
    try:
        app = adsk.core.Application.get(); ui = app.userInterface
        P = dict(PARAMS); reused = read_existing(app, P)
        C, G = layout(P); ok, report = run_checks(P, C, G)
        if not ok:
            r = ui.messageBox('Pre-build fit check FAILED:\n\n' + '\n'.join(l for l in report if l.startswith('FAIL')) + '\n\nBuild anyway?', 'Fit check', adsk.core.MessageBoxButtonTypes.YesNoButtonType)
            if r != adsk.core.DialogResults.DialogYes: return
        outdir = os.path.join(os.path.expanduser('~'), 'Documents', 'HANDHELD_COMMUNICATOR_EXPORT'); os.makedirs(outdir, exist_ok=True)
        app.documents.add(adsk.core.DocumentTypes.FusionDesignDocumentType)
        design = adsk.fusion.Design.cast(app.activeProduct)
        try: design.fusionUnitsManager.distanceDisplayUnits = adsk.fusion.DistanceUnits.MillimeterDistanceUnits
        except: pass
        for k, v in P.items():
            try: design.userParameters.add(k, adsk.core.ValueInput.createByString('%s mm' % repr(float(v))), 'mm', 'Handheld communicator parameter')
            except: warn('Parameter not created: ' + k)
        make_apps(app, design)
        root = design.rootComponent
        mocc = root.occurrences.addNewComponent(adsk.core.Matrix3D.create()); master = mocc.component; master.name = 'HANDHELD_COMMUNICATOR_MODEL'
        rocc, rcomp, rbody = build_rear(master, P, C, G)
        paint(rbody, 'shell_rear')
        focc, fcomp, fbody = build_front(master, P, C, G)
        paint(fbody, 'shell_front')
        kocc, kcomp = build_keycaps(master, P, G)
        for i in range(kcomp.bRepBodies.count): paint(kcomp.bRepBodies.item(i), 'keycap')
        xocc, xcomp, refs = build_refs(master, P, C, G)
        vocc = build_visuals(master, P, C, G)
        docc, dcomp, files = build_dxf(master, P, C, G, outdir)
        try: docc.isLightBulbOn = False
        except: pass
        # Fusion interference analysis of the real model (shells + keycaps + hidden envelope bodies)
        interf = 'not run'
        try:
            col = adsk.core.ObjectCollection.create()
            for o in (rocc, focc, kocc, xocc):
                px = o.createForAssemblyContext(mocc)
                for i in range(px.bRepBodies.count): col.add(px.bRepBodies.item(i))
            inp = design.createInterferenceInput(col); inp.areCoincidentFacesInterference = False
            res = design.analyzeInterference(inp); lines = []
            for i in range(res.count):
                it = res.item(i); lines.append('%s <-> %s  %.3f mm3' % (it.entityOne.name, it.entityTwo.name, it.interferenceBody.volume*1000.0))
            interf = 'NONE' if not lines else '\n'.join(lines)
        except: interf = 'Fusion interference analysis could not run (see analytic checks)'
        # envelopes stay hidden; the detailed component models stay visible inside the enclosure
        try: xocc.isLightBulbOn = False
        except: pass
        try: vocc.isLightBulbOn = bool(SHOW_COMPONENTS)
        except: pass
        if SHOW_COMPONENTS:
            try: focc.opacity = 0.35   # ghost the front shell so the parts inside are visible
            except: warn('Front shell transparency not applied - hide FRONT_SHELL manually to see inside')
        exp = design.exportManager; made = []
        for comp, nm in ((rcomp, 'REAR_SHELL'), (fcomp, 'FRONT_SHELL'), (kcomp, 'KEYCAPS')):
            try:
                o = exp.createSTLExportOptions(comp, os.path.join(outdir, nm+'.stl')); o.meshRefinement = adsk.fusion.MeshRefinementSettings.MeshRefinementHigh
                exp.execute(o); made.append(nm+'.stl')
            except: warn('STL export failed: '+nm)
        try:
            exp.execute(exp.createFusionArchiveExportOptions(os.path.join(outdir, 'HANDHELD_COMMUNICATOR_MODEL.f3d'), root)); made.append('HANDHELD_COMMUNICATOR_MODEL.f3d')
        except: warn('F3D archive export failed - use File > Export')
        place = ['PLACEMENT (mm, centre origin): %-15s X %7.1f..%7.1f  Y %7.1f..%7.1f  Z %6.1f..%6.1f' % ((n,) + tuple(c[k] for k in ('x0', 'x1', 'y0', 'y1', 'z0', 'z1'))) for n, c in C.items()]
        txt = '\n'.join(report)+'\n\n'+'\n'.join(place)+'\n\nFusion interference analysis: '+interf+'\n\nWarnings:\n'+('\n'.join(WARN) if WARN else 'none')
        open(os.path.join(outdir, 'CLEARANCE_REPORT.txt'), 'w').write(txt)
        ui.messageBox('Done. Output folder:\n%s\n\nDXF: %d files\nOther: %s\n\nFit check: %s\nInterference: %s\nWarnings: %d (see CLEARANCE_REPORT.txt)' % (outdir, len(files), ', '.join(made), 'ALL PASS' if ok else 'SEE REPORT', interf.split('\n')[0], len(WARN)), 'HANDHELD COMMUNICATOR')
    except:
        if ui: ui.messageBox('Failed:\n{}'.format(traceback.format_exc()))
