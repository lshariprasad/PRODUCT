def make_apps(app, design):
    base = None
    try:
        for i in range(app.materialLibraries.count):
            lib = app.materialLibraries.item(i)
            if 'ppearance' not in lib.name: continue
            for cand in ('Plastic - Matte (Black)', 'Plastic - Glossy (Black)', 'Paint - Enamel Glossy (Black)', 'Plastic - Matte (White)', 'ABS (White)'):
                try: a = lib.appearances.itemByName(cand)
                except: a = None
                if a: base = a; break
            if base: break
    except: pass
    if base is None: warn('Appearance library not found - parts keep the default colour'); return
    for k, (r, g, b) in COLORS.items():
        try:
            ap = design.appearances.addByCopy(base, 'HC_' + k)
            cp = adsk.core.ColorProperty.cast(ap.appearanceProperties.itemByName('Color'))
            cp.value = adsk.core.Color.create(r, g, b, 255); APPS[k] = ap
        except: pass

def paint(b, key):
    try:
        if key in APPS: b.appearance = APPS[key]
    except: pass

