def vb(comp, x0, y0, z0, x1, y1, z1, name, key):
    b = box_body(comp, x0, y0, z0, x1, y1, z1, name); paint(b, key); return b

def vmulti(comp, z0, z1, drawer, name, key):
    sk = sk_new(comp, z0, 'SK_' + name); drawer(sk)
    f = ext(comp, sk, z1-z0, NEW, 'EXT_' + name)
    for i in range(f.bodies.count):
        b = f.bodies.item(i); b.name = '%s_%d' % (name, i+1); paint(b, key)

def vpcb(comp, x0, y0, z0, x1, y1, z1, holes, name, key):
    sk = sk_new(comp, z0, 'SK_' + name); rect(sk, x0, y0, x1, y1)
    for h in holes: circ(sk, h[0], h[1], h[2])
    prof = None
    try: prof = [max([sk.profiles.item(i) for i in range(sk.profiles.count)], key=lambda p: p.areaProperties().area)]
    except: prof = None
    b = ext(comp, sk, z1-z0, NEW, 'EXT_' + name, prof).bodies.item(0); b.name = name; paint(b, key); return b

def vcyl(comp, axis, c, a, b_, d, length, name, key):
    """cylinder along X (axis 'X': a=y, b_=z) or along Y (axis 'Y': a=x, b_=z); c = centre coordinate along the axis"""
    sk = vsketch(comp, axis, c, 'SK_' + name)
    p = msp(sk, c, a, b_) if axis == 'X' else msp(sk, a, c, b_)
    sk.sketchCurves.sketchCircles.addByCenterRadius(p, mm(d/2.0))
    b = ext_sym(comp, sk, length, NEW, 'EXT_' + name).bodies.item(0); b.name = name; paint(b, key); return b

def vzcyl(comp, x, y, z0, z1, d, name, key):
    sk = sk_new(comp, z0, 'SK_' + name); circ(sk, x, y, d)
    b = ext(comp, sk, z1-z0, NEW, 'EXT_' + name).bodies.item(0); b.name = name; paint(b, key); return b

